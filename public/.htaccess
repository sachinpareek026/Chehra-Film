<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule ^.*$ /index.html [L]
</IfModule>

# Hostinger 404 fallback to SPA index.html
ErrorDocument 404 /index.html

# Prevent directory listings
Options -Indexes

# Cache Control & Invalidation for Hostinger & Apache
<IfModule mod_headers.c>
  # Never cache HTML files or XML sitemaps
  <FilesMatch "\.(html|htm|xml|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache version-hashed JS & CSS assets with revalidation
  <FilesMatch "\.(js|css|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Set proper MIME types for modern web assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>
